    "measurement_interval_min": 5,
    "measurement_note": "Measurement interval is 5 mission minutes (demo: 0.5 real seconds, time multiplier 600); 3 consecutive measurements = 15 mission minutes."
  },
  "proposed_rules": {
    "crew_hr_rest_rise_caution": {
      "condition": "activity = resting AND pulse − baseline ≥ 15",
      "consecutive_required": 3,
      "source": "ranges.json kalp_yuku (assumption)",
      "metric": "heart_rate",
      "skip_when": [
        "exercise"
      ]
    },
    "crew_hr_rest_rise_critical": {
      "condition": "activity = resting AND pulse − baseline ≥ 30",
      "consecutive_required": 3,
      "source": "ranges.json kalp_yuku (assumption)",
      "metric": "heart_rate",
      "skip_when": [
        "exercise"
      ]
    },
    "cabin_pp_co2_caution": {
      "condition": "cabin ppCO2 > 2.5 (instantaneous)",
      "consecutive_required": 3,
      "source": "ranges.json kabin.ppco2_sari_esik (OCHMO-TB-004, partial)",
      "metric": "pp_co2"
    },
    "cabin_pp_co2_critical": {
      "condition": "cabin ppCO2 1-hour average > 3.0",
      "consecutive_required": 3,
      "source": "ranges.json kabin.ppco2_limit_1saat_ort ([V2 6004], verified)",
      "metric": "pp_co2",
      "average_window_min": 60
    },
    "crew_co2_effect_caution": {
      "condition": "cabin ppCO2 > 2.5 AND respiration − baseline ≥ 4",
      "consecutive_required": 3,
      "source": "ranges.json olasi_co2_etkisi",
      "metric": "resp_rate",
      "also_requires": "cabin ppCO2 > 2.5"
    },
    "crew_co2_effect_critical": {
      "condition": "cabin 1-hour avg. > 3.0 AND respiration − baseline ≥ 4",
      "consecutive_required": 3,
      "source": "ranges.json olasi_co2_etkisi + [V2 6004]",
      "metric": "resp_rate",
      "also_requires": "cabin 1-hour average > 3.0"
    }
  },
