  "proposed_rules": {
    "crew_hr_rest_rise_caution": {
      "condition": "aktivite = dinlenme VE nabız − baz ≥ 15",
      "consecutive_required": 3,
      "source": "ranges.json kalp_yuku (varsayım)",
      "metric": "heart_rate",
      "skip_when": [
        "exercise"
      ]
    },
    "crew_hr_rest_rise_critical": {
      "condition": "aktivite = dinlenme VE nabız − baz ≥ 30",
      "consecutive_required": 3,
      "source": "ranges.json kalp_yuku (varsayım)",
      "metric": "heart_rate",
      "skip_when": [
        "exercise"
      ]
    },
    "cabin_pio2_low_caution": {
      "condition": "kabin PIO2 < 145 (normoksi alt sınırı)",
      "consecutive_required": 3,
      "source": "ranges.json kabin.pio2_normoksi_hedef (Tablo 6.2-1, doğrulandı)",
      "metric": "pp_o2"
    },
    "cabin_pio2_low_critical": {
      "condition": "kabin PIO2 < 127 (hafif hipoksi alt sınırı)",
      "consecutive_required": 3,
      "source": "ranges.json kabin.pio2_hafif_hipoksi_alt (Tablo 6.2-1, doğrulandı)",
      "metric": "pp_o2"
    },
    "crew_hypoxia_caution": {
      "condition": "SpO2 düşüşü ≥ 3 VE kabin PIO2 < 145; dinlenirken ek olarak nabız veya solunum artışı ≥ izle",
      "consecutive_required": 3,
      "source": "ranges.json vital_karar_parametreleri.kararlar.olasi_hipoksi (egzersiz istisnası dahil, #21)",
      "metric": "spo2",
      "also_requires": "cabin PIO2 < 145"
    },
    "crew_hypoxia_critical": {
      "condition": "SpO2 düşüşü ≥ 6 VE kabin PIO2 < 145",
      "consecutive_required": 3,
      "source": "ranges.json spo2_dusus.eylem (varsayım)",
      "metric": "spo2",
      "also_requires": "cabin PIO2 < 145"
    },
    "exercise_rule": "Egzersizde nabız ve solunum artışı alarm ve hipoksi kanıtı sayılmaz (kullanıcı kuralı). ranges.json olasi_hipoksi koşulu bu istisnayı içerir (#21): nabız/solunum artışı yalnızca dinlenen kişide aranır."
  },
