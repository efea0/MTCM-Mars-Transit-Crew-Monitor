      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "crew_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Kabin uyarısında null.",
          "title": "Crew Id"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "consecutive_count": {
          "minimum": 1,
          "title": "Consecutive Count",
          "type": "integer"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "why": {
          "description": "En az bir kanıt zorunlu.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Why",
          "type": "array"
        }
      },
      "required": [
        "id",
        "crew_id",
        "metric",
        "severity",
        "message",
        "rule_id",
        "consecutive_count",
        "first_seen",
        "last_seen",
        "why"
