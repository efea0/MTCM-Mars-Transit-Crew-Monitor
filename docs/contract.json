{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mars Transit Crew Health & Cabin Air Monitor - API contract",
  "contract_version": "0.2.0",
  "generated_from": "backend/models.py",
  "crew_size": 4,
  "roots": {
    "TelemetryFrame": {
      "$ref": "#/$defs/TelemetryFrame"
    },
    "Alert": {
      "$ref": "#/$defs/Alert"
    },
    "ThresholdRule": {
      "$ref": "#/$defs/ThresholdRule"
    },
    "CommsMessage": {
      "$ref": "#/$defs/CommsMessage"
    }
  },
  "$defs": {
    "Activity": {
      "description": "Astronaut's current activity. Raised heart/respiratory rate during exercise\nis not counted as an alarm or evidence.",
      "enum": [
        "resting",
        "exercise",
        "sleep",
        "unknown"
      ],
      "title": "Activity",
      "type": "string"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "crew_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for a cabin alert.",
          "title": "Crew Id"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "consecutive_count": {
          "minimum": 1,
          "title": "Consecutive Count",
          "type": "integer"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "why": {
          "description": "At least one piece of evidence is required.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Why",
          "type": "array"
        }
      },
      "required": [
        "id",
        "crew_id",
        "metric",
        "severity",
        "message",
        "rule_id",
        "consecutive_count",
        "first_seen",
        "last_seen",
        "why"
      ],
      "title": "Alert",
      "type": "object"
    },
    "CabinAtmosphere": {
      "additionalProperties": false,
      "properties": {
        "pp_co2": {
          "$ref": "#/$defs/Reading"
        },
        "pp_o2": {
          "$ref": "#/$defs/Reading"
        },
        "cabin_pressure": {
          "$ref": "#/$defs/Reading"
        },
        "cabin_temp": {
          "$ref": "#/$defs/Reading"
        },
        "rel_humidity": {
          "$ref": "#/$defs/Reading"
        },
        "radiation_dose_rate": {
          "$ref": "#/$defs/Reading"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "unknown"
        },
        "hours_until_o2_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time until the O₂ limit (hours); None = not approaching it or not computable; 0.0 = limit already exceeded.",
          "title": "Hours Until O2 Limit"
        },
        "hours_until_co2_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time until the CO₂ limit (hours); None = not approaching it or not computable; 0.0 = limit already exceeded.",
          "title": "Hours Until Co2 Limit"
        }
      },
      "required": [
        "pp_co2",
        "pp_o2",
        "cabin_pressure",
        "cabin_temp",
        "rel_humidity",
        "radiation_dose_rate"
      ],
      "title": "CabinAtmosphere",
      "type": "object"
    },
    "CommsMessage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        },
        "deliver_at": {
          "description": "sent_at + one-way light delay.",
          "format": "date-time",
          "title": "Deliver At",
          "type": "string"
        },
        "one_way_delay_s": {
          "minimum": 0,
          "title": "One Way Delay S",
          "type": "number"
        }
      },
      "required": [
        "id",
        "sender",
        "body",
        "sent_at",
        "deliver_at",
        "one_way_delay_s"
      ],
      "title": "CommsMessage",
      "type": "object"
    },
    "Comparator": {
      "enum": [
        "<",
        "<=",
        ">",
        ">=",
        "missing"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "CrewDecision": {
      "description": "Per-crew-member decision: normal = Normal, watch = Watch, action = Action, unknown = Unknown.",
      "enum": [
        "normal",
        "watch",
        "action",
        "unknown"
      ],
      "title": "CrewDecision",
      "type": "string"
    },
    "CrewMember": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "E.g. 'crew-1'.",
          "pattern": "^crew-[1-9]$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "description": "E.g. 'Commander', 'Flight Surgeon'.",
          "title": "Role",
          "type": "string"
        },
        "vitals": {
          "$ref": "#/$defs/CrewVitals"
        },
        "activity": {
          "$ref": "#/$defs/Activity",
          "default": "unknown"
        },
        "cumulative_dose_msv": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Career cumulative effective dose (mSv, simulated); vs. the 600 mSv career limit.",
          "title": "Cumulative Dose Msv"
        },
        "event_dose_msv": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dose received during an active solar particle event (mSv, simulated); null if no event.",
          "title": "Event Dose Msv"
        },
        "sleep": {
          "anyOf": [
            {
              "$ref": "#/$defs/SleepSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last completed sleep period; null when the scenario carries no sleep data. Missing sleep data never counts as enough sleep."
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "unknown"
        },
        "decision": {
          "$ref": "#/$defs/CrewDecision",
          "default": "unknown",
          "description": "Per-crew-member decision; set by rules.py. unknown if not evaluated or data missing."
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "vitals"
      ],
      "title": "CrewMember",
      "type": "object"
    },
    "CrewVitals": {
      "additionalProperties": false,
      "properties": {
        "heart_rate": {
          "$ref": "#/$defs/Reading"
        },
        "hrv_rmssd": {
          "$ref": "#/$defs/Reading"
        },
        "spo2": {
          "$ref": "#/$defs/Reading"
        },
        "resp_rate": {
          "$ref": "#/$defs/Reading"
        },
        "core_temp": {
          "$ref": "#/$defs/Reading"
        },
        "systolic_bp": {
          "$ref": "#/$defs/Reading"
        },
        "diastolic_bp": {
          "$ref": "#/$defs/Reading"
        }
      },
      "required": [
        "heart_rate",
        "hrv_rmssd",
        "spo2",
        "resp_rate",
        "core_temp",
        "systolic_bp",
        "diastolic_bp"
      ],
      "title": "CrewVitals",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A single evidence item in an alert's 'why?' list.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Limit that was crossed; null for missing-data evidence.",
          "title": "Threshold"
        },
        "comparator": {
          "$ref": "#/$defs/Comparator"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "note": {
          "description": "Human-readable explanation, e.g. 'SpO2 below threshold for 3 measurements'.",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value",
        "threshold",
        "comparator",
        "ts",
        "note"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "heart_rate",
        "hrv_rmssd",
        "spo2",
        "resp_rate",
        "core_temp",
        "systolic_bp",
        "diastolic_bp",
        "pp_co2",
        "pp_o2",
        "cabin_pressure",
        "cabin_temp",
        "rel_humidity",
        "radiation_dose_rate",
        "pio2",
        "event_dose",
        "sleep_hours"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Quality": {
      "enum": [
        "ok",
        "stale",
        "missing",
        "sensor_fault"
      ],
      "title": "Quality",
      "type": "string"
    },
    "Reading": {
      "additionalProperties": false,
      "description": "A single sensor reading. If value=None, quality cannot be 'ok'.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Measured value; null if no data.",
          "title": "Value"
        },
        "unit": {
          "description": "E.g. 'bpm', '%', 'mmHg'.",
          "title": "Unit",
          "type": "string"
        },
        "ts": {
          "description": "Measurement time (UTC, ISO-8601).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality",
          "default": "ok"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "unknown",
          "description": "Filled in by rules.py; unknown if not evaluated."
        },
        "baseline_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Crew vitals only: value minus the person's own baseline (in the reading's unit). Null for cabin readings and when there is no data.",
          "title": "Baseline Delta"
        }
      },
      "required": [
        "value",
        "unit",
        "ts"
      ],
      "title": "Reading",
      "type": "object"
    },
    "Scenario": {
      "enum": [
        "nominal",
        "hypoxia",
        "hypercapnia",
        "sleep_deprivation",
        "solar_storm",
        "sensor_dropout"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "Sender": {
      "enum": [
        "crew",
        "mission_control",
        "system"
      ],
      "title": "Sender",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "caution",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SleepSummary": {
      "additionalProperties": false,
      "description": "Most recently completed sleep period of one crew member (simulated, not a medical record).",
      "properties": {
        "period": {
          "description": "Counter of completed sleep periods; increases by one with each new period. rules.py counts consecutive short periods by watching this counter change.",
          "minimum": 0,
          "title": "Period",
          "type": "integer"
        },
        "hours": {
          "$ref": "#/$defs/Reading",
          "description": "Duration of that period in hours (unit 'h'); status filled by rules.py."
        }
      },
      "required": [
        "period",
        "hours"
      ],
      "title": "SleepSummary",
      "type": "object"
    },
    "Status": {
      "description": "Overall status of a measurement, a crew member, or the cabin.",
      "enum": [
        "nominal",
        "caution",
        "warning",
        "critical",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "TelemetryFrame": {
      "additionalProperties": false,
      "description": "Full packet sent over SSE on every tick (event: telemetry).",
      "properties": {
        "contract_version": {
          "default": "0.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "mission_elapsed_s": {
          "minimum": 0,
          "title": "Mission Elapsed S",
          "type": "number"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "simulated": {
          "default": true,
          "description": "Drives the 'SIMULATED' label on screen.",
          "title": "Simulated",
          "type": "boolean"
        },
        "crew": {
          "items": {
            "$ref": "#/$defs/CrewMember"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Crew",
          "type": "array"
        },
        "cabin": {
          "$ref": "#/$defs/CabinAtmosphere"
        },
        "alerts": {
          "items": {
            "$ref": "#/$defs/Alert"
          },
          "title": "Alerts",
          "type": "array"
        },
        "comms_one_way_delay_s": {
          "minimum": 0,
          "title": "Comms One Way Delay S",
          "type": "number"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/CommsMessage"
          },
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "tick",
        "ts",
        "mission_elapsed_s",
        "scenario",
        "crew",
        "cabin",
        "comms_one_way_delay_s"
      ],
      "title": "TelemetryFrame",
      "type": "object"
    },
    "ThresholdRule": {
      "additionalProperties": false,
      "description": "Rule structure. Numeric values and their sources are defined in rules.py.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "comparator": {
          "$ref": "#/$defs/Comparator"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null if comparator=missing.",
          "title": "Threshold"
        },
        "consecutive_required": {
          "description": "Number of consecutive measurements required to raise an alert.",
          "minimum": 1,
          "title": "Consecutive Required",
          "type": "integer"
        },
        "average_window_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Averaging window (s); e.g. 3600 for CO₂ = 1-hour average. null = instantaneous value.",
          "title": "Average Window S"
        },
        "relative_to_baseline": {
          "default": false,
          "description": "If true, the compared quantity is 'value minus the person's baseline' and threshold is read as a difference in the same unit (e.g. heart rate +15, SpO₂ −3). False = absolute threshold.",
          "title": "Relative To Baseline",
          "type": "boolean"
        },
        "skip_when": {
          "description": "Rule is skipped during these activities; e.g. ['exercise'] for heart-rate deviation.",
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "title": "Skip When",
          "type": "array"
        },
        "source": {
          "description": "Source of the threshold (NASA-STD-3001 etc.) or 'HYPOTHESIS'.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "metric",
        "severity",
        "comparator",
        "threshold",
        "consecutive_required",
        "source"
      ],
      "title": "ThresholdRule",
      "type": "object"
    }
  }
}
