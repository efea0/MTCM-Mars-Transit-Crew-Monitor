      "title": "CabinAtmosphere",
      "type": "object"
    },
    "CommsMessage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        },
        "deliver_at": {
          "description": "sent_at + tek yön ışık gecikmesi.",
          "format": "date-time",
          "title": "Deliver At",
          "type": "string"
        },
        "one_way_delay_s": {
          "minimum": 0,
