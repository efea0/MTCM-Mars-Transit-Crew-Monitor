    "Metric": {
      "enum": [
        "heart_rate",
        "hrv_rmssd",
        "spo2",
        "resp_rate",
        "core_temp",
        "systolic_bp",
        "diastolic_bp",
        "pp_co2",
        "pp_o2",
        "cabin_pressure",
        "cabin_temp",
        "rel_humidity",
        "radiation_dose_rate"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Quality": {
      "enum": [
        "ok",
        "stale",
        "missing",
        "sensor_fault"
      ],
