    "CabinAtmosphere": {
      "additionalProperties": false,
      "properties": {
        "pp_co2": {
          "$ref": "#/$defs/Reading"
        },
        "pp_o2": {
          "$ref": "#/$defs/Reading"
        },
        "cabin_pressure": {
          "$ref": "#/$defs/Reading"
        },
        "cabin_temp": {
          "$ref": "#/$defs/Reading"
        },
        "rel_humidity": {
          "$ref": "#/$defs/Reading"
        },
        "radiation_dose_rate": {
          "$ref": "#/$defs/Reading"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "unknown"
        }
