        "hrv_rmssd": {
          "$ref": "#/$defs/Reading"
        },
        "spo2": {
          "$ref": "#/$defs/Reading"
        },
        "resp_rate": {
          "$ref": "#/$defs/Reading"
        },
        "core_temp": {
          "$ref": "#/$defs/Reading"
        },
        "systolic_bp": {
          "$ref": "#/$defs/Reading"
        },
        "diastolic_bp": {
          "$ref": "#/$defs/Reading"
        }
      },
      "required": [
        "heart_rate",
        "hrv_rmssd",
        "spo2",
        "resp_rate",
        "core_temp",
        "systolic_bp",
        "diastolic_bp"
      ],
      "title": "CrewVitals",
      "type": "object"
