          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "description": "Örn. 'Commander', 'Flight Surgeon'.",
          "title": "Role",
          "type": "string"
        },
        "vitals": {
          "$ref": "#/$defs/CrewVitals"
