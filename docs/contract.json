    "Evidence": {
      "additionalProperties": false,
      "description": "Bir uyarının 'neden?' listesindeki tek kanıt maddesi.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
