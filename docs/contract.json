      "type": "object"
    },
    "ThresholdRule": {
      "additionalProperties": false,
      "description": "Kural yapısı. Sayısal değerler ve kaynakları rules.py içinde tanımlanır.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "comparator": {
          "$ref": "#/$defs/Comparator"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "comparator=missing ise null.",
          "title": "Threshold"
        },
        "consecutive_required": {
          "description": "Uyarı için art arda kaç ölçüm.",
          "minimum": 1,
          "title": "Consecutive Required",
          "type": "integer"
        },
        "source": {
          "description": "Eşiğin kaynağı (NASA-STD-3001 vb.) veya 'HİPOTEZ'.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "metric",
        "severity",
        "comparator",
        "threshold",
        "consecutive_required",
        "source"
      ],
      "title": "ThresholdRule",
      "type": "object"
    }
