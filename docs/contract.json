      "type": "string"
    },
    "Status": {
      "description": "Bir ölçümün, kişinin veya kabinin genel durumu.",
      "enum": [
        "nominal",
        "caution",
        "warning",
        "critical",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "TelemetryFrame": {
      "additionalProperties": false,
      "description": "SSE ile her tick'te gönderilen tam paket (event: telemetry).",
      "properties": {
        "contract_version": {
          "default": "0.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "mission_elapsed_s": {
          "minimum": 0,
          "title": "Mission Elapsed S",
          "type": "number"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "simulated": {
          "default": true,
          "description": "Ekranda 'SİMÜLE' etiketi için.",
          "title": "Simulated",
          "type": "boolean"
