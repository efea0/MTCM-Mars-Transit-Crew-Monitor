        "comparator": {
          "$ref": "#/$defs/Comparator"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "note": {
          "description": "İnsan-okunur açıklama, örn. 'SpO2 3 ölçümdür eşiğin altında'.",
